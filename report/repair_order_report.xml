<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Acción para registrar el reporte -->
    <record id="action_report_repair_order" model="ir.actions.report">
        <field name="name">Orden de Reparación</field>
        <field name="model">repair.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_repair_management.report_repair_order_document</field>
        <field name="report_file">custom_repair_management.report_repair_order_document</field>
        <field name="print_report_name">'Orden_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="model_repair_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 2. Plantilla QWeb del PDF -->
    <template id="report_repair_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-6">
                                <h2><span t-field="doc.name"/></h2>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Estado: </strong>
                                <span t-field="doc.state"/>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Cliente:</strong> <span t-field="doc.partner_id.name"/><br/>
                                <strong>Equipo / Modelo:</strong> <span t-field="doc.equipment_name"/><br/>
                                <strong>Número de Serie:</strong> <span t-field="doc.serial_number"/>
                            </div>
                            <div class="col-6">
                                <strong>Aplica Garantía:</strong> 
                                <span t-if="doc.guarantee">Sí</span>
                                <span t-else="">No</span>
                            </div>
                        </div>

                        <h4 class="mt-3">Diagnóstico / Fallo Reportado</h4>
                        <p class="border p-2" t-field="doc.description"/>

                        <h4 class="mt-4">Piezas y Repuestos Utilizados</h4>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Repuesto / Servicio</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Precio Unitario</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><span t-field="line.product_id.display_name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.unit_price"/></td>
                                    <td class="text-end"><span t-field="line.subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row justify-content-end mt-3">
                            <div class="col-4">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Costo Total:</strong></td>
                                        <td class="text-end">
                                            <strong><span t-field="doc.total_amount"/></strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>